
<%- include("../partials/header", { title: title }) %>

<section id="one">
    <div class="inner">
        <header class="major">
            <h1>Labdarúgó szerkesztése</h1>
        </header>

        <p>
            Módosítsd a kiválasztott labdarúgó adatait.
        </p>

        <% if (hibak && hibak.length > 0) { %>
            <div class="flash flash-error">
                <ul>
                    <% hibak.forEach(hiba => { %>
                        <li><%= hiba %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>

        <form
            method="POST"
            action="/crud/edit/<%= labdarugo._id %>"
            class="crud-form"
        >
            <div class="fields">

                <div class="field half">
                    <label for="vezeteknev">Vezetéknév</label>
                    <input
                        type="text"
                        id="vezeteknev"
                        name="vezeteknev"
                        value="<%= adatok.vezeteknev ?? '' %>"
                        required
                    >
                </div>

                <div class="field half">
                    <label for="utonev">Utónév</label>
                    <input
                        type="text"
                        id="utonev"
                        name="utonev"
                        value="<%= adatok.utonev ?? '' %>"
                        required
                    >
                </div>

                <div class="field half">
                    <label for="mezszam">Mezszám</label>
                    <input
                        type="number"
                        id="mezszam"
                        name="mezszam"
                        min="<%= szabalyok.mezszamMin %>"
                        max="<%= szabalyok.mezszamMax %>"
                        step="1"
                        value="<%= adatok.mezszam ?? '' %>"
                        required
                    >
                </div>

                <div class="field half">
                    <label for="szulido">Születési dátum</label>
                    <input
                        type="date"
                        id="szulido"
                        name="szulido"
                        min="<%= datumHatarok.min %>"
                        max="<%= datumHatarok.max %>"
                        value="<%= adatok.szulido ?? '' %>"
                        required
                    >
                </div>

                <div class="field half">
                    <label for="klub">Klub</label>
                    <select id="klub" name="klub" required>
                        <option value="">Válassz klubot</option>

                        <% klubok.forEach(klub => { %>
                            <option
                                value="<%= klub._id %>"
                                <%= String(adatok.klub) === String(klub._id) ? 'selected' : '' %>
                            >
                                <%= klub.csapatnev %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="field half">
                    <label for="poszt">Poszt</label>
                    <select id="poszt" name="poszt" required>
                        <option value="">Válassz posztot</option>

                        <% posztok.forEach(poszt => { %>
                            <option
                                value="<%= poszt._id %>"
                                <%= String(adatok.poszt) === String(poszt._id) ? 'selected' : '' %>
                            >
                                <%= poszt.nev %>
                            </option>
                        <% }) %>
                    </select>
                </div>

                <div class="field half">
                    <label for="ertek">Játékos értéke (ezer €)</label>
                    <input
                        type="number"
                        id="ertek"
                        name="ertek"
                        min="<%= szabalyok.ertekMin %>"
                        max="<%= szabalyok.ertekMax %>"
                        step="1"
                        value="<%= adatok.ertek ?? '' %>"
                        required
                    >
                </div>

                <div class="field">
                    <label>Állampolgársági kategória</label>

                    <input
                        type="checkbox"
                        id="magyar"
                        name="magyar"
                        <%= adatok.magyar === 'on' ? 'checked' : '' %>
                    >
                    <label for="magyar">Magyar</label>

                    <input
                        type="checkbox"
                        id="kulfoldi"
                        name="kulfoldi"
                        <%= adatok.kulfoldi === 'on' ? 'checked' : '' %>
                    >
                    <label for="kulfoldi">Külföldi</label>
                </div>

            </div>

            <ul class="actions">
                <li>
                    <button type="submit" class="primary">
                        Módosítások mentése
                    </button>
                </li>

                <li>
                    <a href="/crud" class="button">
                        Mégse
                    </a>
                </li>
            </ul>
        </form>
    </div>
</section>

<%- include("../partials/footer") %>
