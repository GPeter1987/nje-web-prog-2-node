
<%- include("../partials/header") %>

<h2>Labdarúgók listája</h2>
<p>
    <a href="/crud/create" class="button primary">
        Új labdarúgó felvétele
    </a>
</p>

<p>
    Az adatbázisban szereplő labdarúgók száma:
    <strong><%= labdarugok.length %></strong>
</p>

<div class="table-wrapper">
    <table class="alt">
        <thead>
            <tr>
                <th>Mezszám</th>
                <th>Vezetéknév</th>
                <th>Utónév</th>
                <th>Klub</th>
                <th>Poszt</th>
                <th>Érték (ezer €)</th>
                <th>Műveletek</th>
            </tr>
        </thead>

        <tbody>
            <% labdarugok.forEach(jatekos => { %>
                <tr>
                    <td><%= jatekos.mezszam %></td>
                    <td><%= jatekos.vezeteknev %></td>
                    <td><%= jatekos.utonev %></td>
                    <td>
                        <%= jatekos.klub
                            ? jatekos.klub.csapatnev
                            : "-" %>
                    </td>
                    <td>
                        <%= jatekos.poszt
                            ? jatekos.poszt.nev
                            : "-" %>
                    </td>
                    <td><%= jatekos.ertek %></td>
                    <td>
                        <span>Szerkesztés</span>
                        |
                        <span>Törlés</span>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<%- include("../partials/footer") %>

